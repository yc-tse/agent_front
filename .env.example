# ---------------------------------------------------------------------------
# agent-audit-front — local configuration
# Copy to `.env` (git-ignored) and adjust. Every value can also be supplied
# through Streamlit secrets (.streamlit/secrets.toml) or real env vars.
# ---------------------------------------------------------------------------

# Backend base URL. Leave empty to force mock mode.
AUDIT_API_BASE_URL=http://localhost:8000

# "mock" runs entirely offline with bundled sample missions.
# "live" calls the backend at AUDIT_API_BASE_URL.
AUDIT_BACKEND_MODE=mock

# Auth. AUDIT_API_AUTH_SCHEME is one of: none | bearer | api_key
AUDIT_API_AUTH_SCHEME=none
AUDIT_API_TOKEN=
AUDIT_API_KEY_HEADER=X-API-Key

# Endpoint template. {mission_id} and {stage} are substituted per call.
AUDIT_API_STAGE_PATH=/api/v1/missions/{mission_id}/stages/{stage}
AUDIT_API_HEALTH_PATH=/health
AUDIT_API_JOB_PATH=/api/v1/jobs/{job_id}

# Networking
AUDIT_API_TIMEOUT_S=120
AUDIT_API_MAX_RETRIES=2
AUDIT_API_POLL_INTERVAL_S=2
AUDIT_API_VERIFY_SSL=true

# Analyst identity stamped on the audit trail (falls back to the OS user).
AUDIT_ANALYST=
